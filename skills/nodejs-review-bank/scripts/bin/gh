#!/bin/zsh
# gh shim: runs the real gh with a cross-process lock, so every gh call made
# through bank.py (including build-queue.sh, rereview.py, and ci-status.sh,
# which it runs with this directory first on PATH) is serial, with at least
# GH_MIN_GAP seconds between calls. GitHub's secondary rate limit trips on
# concurrent or bursty calls. A lock whose holder died is taken over.
zmodload zsh/datetime
self="${0:A}"
real=""
for p in ${(s.:.)PATH}; do
  [[ -x "$p/gh" && "${${:-$p/gh}:A}" != "$self" ]] && { real="$p/gh"; break; }
done
[ -n "$real" ] || { echo "gh shim: no gh on PATH besides $self" >&2; exit 127; }

lock="${GH_SHIM_LOCK:-${NODE_REVIEW_BANK:-${XDG_STATE_HOME:-$HOME/.local/state}/nodejs-review-bank}/locks/gh}"
mkdir -p "${lock:h}"
until mkdir "$lock" 2>/dev/null; do
  holder=$(cat "$lock/pid" 2>/dev/null)
  if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
    rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null
  fi
  sleep 0.5
done
print $$ > "$lock/pid"
release() { rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null; }
trap 'release; exit 130' INT TERM

last=$(cat "$lock.last" 2>/dev/null || echo 0)
gap=$(( ${GH_MIN_GAP:-1} - (EPOCHREALTIME - last) ))
(( gap > 0 )) && sleep $gap

"$real" "$@"; rc=$?
print $EPOCHREALTIME > "$lock.last"
release
exit $rc
